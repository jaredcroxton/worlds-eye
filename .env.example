# World's Eye. Placeholder list. No real values here.
# Copy this file to app/.env to run on port 4177 (the port the tools in tools/ expect).
# The live file app/.env is git-ignored. The in-app key screen (Settings, Add or change a key) writes it for you.

# Local server.
PORT=4177
HOST=localhost

# Free keys (sign-up only, no card). All optional.
CESIUM_ION_TOKEN=
AISSTREAM_API_KEY=
FIRMS_MAP_KEY=
TOMTOM_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
LL2_API_TOKEN=

# Paid. Leave empty unless you mean to pay.
# OPENAI_API_KEY turns on voice (a few cents a minute).
# GOOGLE_MAPS_API_KEY needs a billing account, and camera thumbnails can then bill through Street View.
OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=
